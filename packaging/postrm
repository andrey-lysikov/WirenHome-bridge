set -e

# The settings page is generated at runtime; drop it with the package so it leaves the web UI.
if [ "$1" = "remove" ] || [ "$1" = "purge" ]; then
    rm -f /var/lib/wb-mqtt-confed/schemas/wb-homekit.schema.json
fi
if [ "$1" = "purge" ]; then
    rm -f /etc/wb-homekit.conf
fi

systemctl daemon-reload || true
